# API Configuration
API_URL=http://188.119.67.226:8000

# LLM Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# OpenRouter Configuration (used by the OpenRouter variant of the digital twin agent)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-coder-30b-a3b-instruct
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=DigitalTwinBuilder
# Comma-separated upstream providers to skip (Novita drops completion text).
# Leave empty to allow all providers.
OPENROUTER_IGNORE_PROVIDERS=Novita

# Agent Configuration
UI_AGENT_INDEX=0
DB_AGENT_INDEX=1
DT_AGENT_INDEX=2
UI_AGENT_MODEL=models/SmolLM3-3B
DB_AGENT_MODEL=models/SmolLM3-3B
DT_AGENT_MODEL=models/QwenCoder-30B

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=llm_agents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin

# Application Configuration
LOG_LEVEL=INFO
DEBUG=False

# Streamlit Configuration
STREAMLIT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_LOGGER_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
